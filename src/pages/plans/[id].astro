---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { GOAL_LABELS, formatExerciseLoad, planDisplayName } from "@/lib/plans/display";
import type { Plan, PlanExercise } from "@/types";

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let planRow: Plan | null = null;
let exerciseRows: PlanExercise[] = [];

interface RowResult<T> {
  data: T | null;
  error: { message: string } | null;
}

if (supabase && id) {
  const planResult = (await supabase.from("plans").select("*").eq("id", id).maybeSingle()) as RowResult<Plan>;

  if (!planResult.error && planResult.data) {
    planRow = planResult.data;

    const exercisesResult = (await supabase
      .from("plan_exercises")
      .select("*")
      .eq("plan_id", id)
      .order("sort_order", { ascending: true })) as RowResult<PlanExercise[]>;

    if (!exercisesResult.error && exercisesResult.data) {
      exerciseRows = exercisesResult.data;
    }
  }
}

const pageTitle = planRow ? planDisplayName(planRow.name, planRow.goal) : "Plan not found";
---

<Layout title={pageTitle}>
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <Topbar />

    <div class="mx-auto max-w-2xl space-y-6 py-8">
      {
        !planRow ? (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <h1 class="mb-2 text-2xl font-bold text-white">Plan not found</h1>
            <p class="mb-6 text-sm text-blue-100/60">This plan does not exist or you do not have access to it.</p>
            <a href="/plans" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              ← Back to plans
            </a>
          </div>
        ) : (
          <>
            <div>
              <a href="/plans" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
                ← Back to plans
              </a>
              <h1 class="mt-4 mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
                {planDisplayName(planRow.name, planRow.goal)}
              </h1>
              <p class="text-sm text-blue-100/60">Goal: {GOAL_LABELS[planRow.goal]}</p>
            </div>

            <section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
              <h2 class="mb-4 text-lg font-semibold text-white">Exercises</h2>
              {exerciseRows.length === 0 ? (
                <p class="text-sm text-blue-100/60">No exercises in this plan.</p>
              ) : (
                <ol class="space-y-3">
                  {exerciseRows.map((exercise, index) => {
                    const load = formatExerciseLoad(exercise.default_load_kg);
                    const details = [exercise.default_reps != null ? `${exercise.default_reps} reps` : null, load]
                      .filter(Boolean)
                      .join(" · ");

                    return (
                      <li class="rounded-lg border border-white/10 bg-white/5 px-4 py-3">
                        <div class="font-medium text-white">
                          {index + 1}. {exercise.name}
                        </div>
                        {details ? <div class="mt-1 text-sm text-blue-100/60">{details}</div> : null}
                      </li>
                    );
                  })}
                </ol>
              )}
            </section>
          </>
        )
      }
    </div>
  </div>
</Layout>
