---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import LogSessionForm from "@/components/sessions/LogSessionForm";
import { createClient } from "@/lib/supabase";
import { planDisplayName } from "@/lib/plans/display";
import type { Plan, PlanExercise } from "@/types";

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let planRow: Plan | null = null;
let exerciseRows: PlanExercise[] = [];
let exercisesFailed = false;

interface RowResult<T> {
  data: T | null;
  error: { message: string } | null;
}

if (supabase && id) {
  const planResult = (await supabase.from("plans").select("*").eq("id", id).maybeSingle()) as RowResult<Plan>;

  if (!planResult.error && planResult.data) {
    planRow = planResult.data;

    const exercisesResult = (await supabase
      .from("plan_exercises")
      .select("*")
      .eq("plan_id", id)
      .order("sort_order", { ascending: true })) as RowResult<PlanExercise[]>;

    if (exercisesResult.error || !exercisesResult.data || exercisesResult.data.length === 0) {
      exercisesFailed = true;
    } else {
      exerciseRows = exercisesResult.data;
    }
  }
}

const pageTitle = planRow ? `Log · ${planDisplayName(planRow.name, planRow.goal)}` : "Plan not found";
const showLog = planRow && !exercisesFailed && exerciseRows.length > 0;
---

<Layout title={pageTitle}>
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <Topbar />

    <div class="mx-auto max-w-2xl space-y-6 py-8">
      {
        !planRow ? (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <h1 class="mb-2 text-2xl font-bold text-white">Plan not found</h1>
            <p class="mb-6 text-sm text-blue-100/60">This plan does not exist or you do not have access to it.</p>
            <a href="/plans" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              ← Back to plans
            </a>
          </div>
        ) : showLog ? (
          <>
            <a
              href={`/plans/${planRow.id}`}
              class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
            >
              ← Back to plan
            </a>
            <LogSessionForm client:load plan={planRow} exercises={exerciseRows} />
          </>
        ) : (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <h1 class="mb-2 text-2xl font-bold text-white">Could not load exercises</h1>
            <p class="mb-6 text-sm text-blue-100/60">This plan cannot be logged until its exercises load.</p>
            <a
              href={`/plans/${planRow.id}`}
              class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
            >
              ← Back to plan
            </a>
          </div>
        )
      }
    </div>
  </div>
</Layout>
